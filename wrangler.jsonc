{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "swagpay",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": true },
  "durable_objects": { "bindings": [{ "name": "OrderAgent", "class_name": "OrderAgent" }, { "name": "TreasuryAgent", "class_name": "TreasuryAgent" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["OrderAgent"] }, { "tag": "v2", "new_sqlite_classes": ["TreasuryAgent"] }],
  "d1_databases": [
    { "binding": "DB", "database_name": "swagpay", "database_id": "8ef3cbfc-c71c-4f16-bb8a-3eefbf2d117d", "migrations_dir": "migrations" }
  ],
  "r2_buckets": [{ "binding": "ARTWORK", "bucket_name": "swagpay-artwork", "jurisdiction": "eu" }],
  "routes": [{ "pattern": "app.swagpay.me", "custom_domain": true }],
  "triggers": { "crons": ["* * * * *"] },
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vars": {
    "MODEL_PROVIDER": "gemini",
    "GEMINI_MODEL": "gemini-3.8-flash",
    "MODEL": "claude-sonnet-5-5",
    "AGENT_AUTORUN": "1",
    "MAX_NEW_ORDERS_PER_DAY": "20",
    "REQUIRE_TURNSTILE": "1",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFJklR1Bu4zO6hP5",
    "ACCESS_TEAM_DOMAIN": "https://falling-shape-11d9.cloudflareaccess.com",
    "ACCESS_AUD": "83b69731a99ebd14d410fcf7f5a6670913a5be1a2f00f93516bab5ccc574f8eb",
    "RECEIVING_ADDRESS": "",
    "ARC_CHAIN_ID": "5042",
    "USDC_ADDRESS": "0x3600000000000000000000000000000000000000",
    "EURC_ADDRESS": "0xbEf5f6d51CB62b58e6A8f77868681825C6fe21c1",
    "ARC_RPC_URL": "https://rpc.blockdaemon.mainnet.arc.io",
    "ARC_RPC_FALLBACK_URL": "",
    "PAYOUT_CHAIN": "ARC",
    "PAYOUT_ADDRESS": "",
    "RESERVE_ADDRESS": "",
    "TREASURY_PER_TX_USDC": "500",
    "TREASURY_DAILY_USDC": "1500",
    "TREASURY_RESERVE_MIN_BPS": "1000",
    "TREASURY_RESERVE_MAX_BPS": "3000"
  }
}
